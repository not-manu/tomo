{
	"name": "tomo",
	"version": "0.5.14",
	"private": true,
	"description": "the multiplayer workspace for humans and agents",
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"typecheck": "turbo typecheck",
		"tc": "turbo typecheck",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"format": "turbo format",
		"test": "turbo test",
		"typegen": "turbo typegen",
		"check": "turbo typecheck lint test",
		"ship": "./scripts/ship.sh",
		"infra:plan": "tofu -chdir=infra plan",
		"infra:apply": "tofu -chdir=infra apply",
		"ssh": "gcloud compute ssh tomo --tunnel-through-iap",
		"db:studio": "turbo db:studio",
		"db:generate": "turbo db:generate",
		"db:migrate": "turbo db:migrate",
		"db:prod:studio": "./scripts/db-prod.sh studio",
		"db:prod:migrate": "./scripts/db-prod.sh migrate",
		"sandbox:build": "docker build -t tomo-sandbox packages/api/src/sandbox"
	},
	"author": "not-manu",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"turbo": "^2.11.4",
		"typescript": "^5.9.3",
		"vitest": "^5.0.2"
	},
	"packageManager": "pnpm@10.32.1"
}
